{
  "name": "playwright-e2e-mcp",
  "version": "0.1.3",
  "description": "MCP server that runs, debugs, and inspects Playwright end-to-end tests from any MCP client",
  "author": "trajectiq-ai <trajectiq@gmail.com>",
  "mcpName": "io.github.trajectiq-ai/E2E",
  "type": "module",
  "license": "MIT",
  "homepage": "https://playwright-e2e-mcp.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trajectiq-ai/E2E.git"
  },
  "bugs": {
    "url": "https://github.com/trajectiq-ai/E2E/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "e2e",
    "end-to-end-testing",
    "testing",
    "ai",
    "automation",
    "selectors"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playwright-e2e-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node test/run-tests.mjs",
    "e2e": "npm run build && node e2e/run.mjs",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "mcpb:smoke": "npm run mcpb && node scripts/mcpb-launch-sim.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
